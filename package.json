{
  "name": "solidflow",
  "version": "0.19.0",
  "private": true,
  "description": "Free, open-source parametric desktop CAD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/start-desktop.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "npm run test:unit && npm run test:ipc",
    "package": "npm run build && electron-builder --publish never",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:desktop:part-fresh-sketch": "node scripts/desktop-part-fresh-sketch.cjs",
    "test:desktop:part-from-empty": "node scripts/desktop-part-from-empty.cjs",
    "test:desktop:part-sequence": "node scripts/desktop-part-sequence.cjs",
    "test:desktop:part-revolution": "node scripts/desktop-part-revolution.cjs",
    "test:desktop:part-finishing": "node scripts/desktop-part-finishing.cjs",
    "test:desktop:part-body-catalog": "node scripts/desktop-part-body-catalog.cjs",
    "test:desktop:assembly-shortcuts": "node scripts/desktop-assembly-shortcuts.cjs",
    "test:desktop:assembly-configured-shortcuts": "node scripts/desktop-assembly-configured-shortcuts.cjs",
    "test:desktop:assembly-basic-authoring": "node scripts/desktop-assembly-basic-authoring.cjs",
    "test:desktop:assembly-origin-axes": "node scripts/desktop-assembly-origin-axes.cjs",
    "test:desktop:assembly-configured-origin-axes": "node scripts/desktop-assembly-configured-origin-axes.cjs",
    "test:desktop:assembly-origin-axis-lock": "node scripts/desktop-assembly-origin-axis-lock.cjs",
    "test:desktop:assembly-configured-origin-axis-lock": "node scripts/desktop-assembly-configured-origin-axis-lock.cjs",
    "test:desktop:assembly-configured-components": "node scripts/desktop-assembly-configured-components.cjs",
    "test:desktop:assembly-configured-picking": "node scripts/desktop-assembly-configured-picking.cjs",
    "test:desktop:assembly-configured-picking-compact": "node scripts/desktop-assembly-configured-picking-compact.cjs",
    "test:desktop:pattern-all": "node scripts/desktop-pattern-all.cjs",
    "test:desktop:imported-bodies": "node scripts/desktop-imported-bodies.cjs",
    "test:desktop:assembly-step": "node scripts/desktop-assembly-step.cjs",
    "test:desktop:assembly-step-insertion": "node scripts/desktop-assembly-step-insertion.cjs",
    "test:desktop:pattern-world-limit": "node scripts/desktop-pattern-world-limit.cjs",
    "test:desktop:pattern-until-next": "node scripts/desktop-pattern-until-next.cjs",
    "test:desktop:assembly": "node scripts/desktop-assembly.cjs",
    "test:desktop:assembly-configurations": "node scripts/desktop-assembly-configurations.cjs",
    "test:desktop:assembly-configured-relations": "node scripts/desktop-assembly-configured-relations.cjs",
    "test:desktop:assembly-configured-compound": "node scripts/desktop-assembly-configured-compound.cjs",
    "test:desktop:assembly-configured-profile-center": "node scripts/desktop-assembly-configured-profile-center.cjs",
    "test:desktop:assembly-configured-profile-circle": "node scripts/desktop-assembly-configured-profile-circle.cjs",
    "test:desktop:assembly-configured-line-path": "node scripts/desktop-assembly-configured-line-path.cjs",
    "test:desktop:assembly-configured-circular-path": "node scripts/desktop-assembly-configured-circular-path.cjs",
    "test:desktop:assembly-configured-mechanical": "node scripts/desktop-assembly-configured-mechanical.cjs",
    "test:desktop:assembly-configured-lock": "node scripts/desktop-assembly-configured-lock.cjs",
    "test:desktop:assembly-configured-concentric": "node scripts/desktop-assembly-configured-concentric.cjs",
    "test:desktop:assembly-configured-gear": "node scripts/desktop-assembly-configured-gear.cjs",
    "test:desktop:assembly-configured-screw": "node scripts/desktop-assembly-configured-screw.cjs",
    "test:desktop:assembly-configured-rack-pinion": "node scripts/desktop-assembly-configured-rack-pinion.cjs",
    "test:desktop:assembly-import": "node scripts/desktop-assembly-import.cjs",
    "test:desktop:assembly-source-update": "node scripts/desktop-assembly-source-update.cjs",
    "test:desktop:assembly-source-update-save-pending": "node scripts/desktop-assembly-source-update-save-pending.cjs",
    "test:desktop:assembly-interference-grouping-scope": "node scripts/desktop-assembly-interference-grouping-scope.cjs",
    "test:desktop:assembly-interference-grouping-multibody": "node scripts/desktop-assembly-interference-grouping-multibody.cjs",
    "test:desktop:assembly-interference-grouping": "node scripts/desktop-assembly-interference-grouping.cjs",
    "test:desktop:assembly-interference-multibody": "node scripts/desktop-assembly-interference-multibody.cjs",
    "test:desktop:assembly-screw": "node scripts/desktop-assembly-screw.cjs",
    "test:desktop:assembly-rack-pinion": "node scripts/desktop-assembly-rack-pinion.cjs",
    "test:desktop:assembly-export": "node scripts/desktop-assembly-export.cjs",
    "test:desktop:assembly-direction": "node scripts/desktop-assembly-direction.cjs",
    "test:desktop:assembly-angle-measurement": "node scripts/desktop-assembly-angle-measurement.cjs",
    "test:desktop:assembly-directed-angle": "node scripts/desktop-assembly-directed-angle.cjs",
    "test:desktop:assembly-tangent": "node scripts/desktop-assembly-tangent.cjs",
    "test:desktop:assembly-cylinder-tangent": "node scripts/desktop-assembly-cylinder-tangent.cjs",
    "test:desktop:assembly-sphere-tangent": "node scripts/desktop-assembly-sphere-tangent.cjs",
    "test:desktop:assembly-limit-distance": "node scripts/desktop-assembly-limit-distance.cjs",
    "test:desktop:assembly-limit-distance-compact": "node scripts/desktop-assembly-limit-distance-compact.cjs",
    "test:desktop:assembly-profile-center": "node scripts/desktop-assembly-profile-center.cjs",
    "test:desktop:assembly-width": "node scripts/desktop-assembly-width.cjs",
    "test:desktop:assembly-symmetry": "node scripts/desktop-assembly-symmetry.cjs",
    "test:desktop:assembly-symmetry-line-repair": "node scripts/desktop-assembly-symmetry-line-repair.cjs",
    "test:desktop:assembly-symmetry-plane-repair": "node scripts/desktop-assembly-symmetry-plane-repair.cjs",
    "test:desktop:assembly-symmetry-sphere-repair": "node scripts/desktop-assembly-symmetry-sphere-repair.cjs",
    "test:desktop:assembly-symmetry-cylinder-repair": "node scripts/desktop-assembly-symmetry-cylinder-repair.cjs",
    "test:desktop:assembly-symmetry-axisline-repair": "node scripts/desktop-assembly-symmetry-axisline-repair.cjs",
    "test:desktop:assembly-symmetry-repair": "node scripts/desktop-assembly-symmetry-repair.cjs",
    "test:desktop:assembly-symmetry-picking": "node scripts/desktop-assembly-symmetry-picking.cjs",
    "test:desktop:assembly-symmetry-nested-selected": "node scripts/desktop-assembly-symmetry-nested-selected.cjs",
    "test:desktop:assembly-symmetry-nested-source": "node scripts/desktop-assembly-symmetry-nested-source.cjs",
    "test:desktop:assembly-limit-angle": "node scripts/desktop-assembly-limit-angle.cjs",
    "test:desktop:assembly-replacement": "node scripts/desktop-assembly-replacement.cjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:ipc": "node --test --test-reporter=spec --test-reporter=./scripts/desktop-node-ci-reporter.cjs --test-reporter-destination=stdout --test-reporter-destination=stdout scripts/desktop-security.node.cjs scripts/desktop-ui-source.node.cjs scripts/desktop-ci-diagnostics.node.cjs scripts/desktop-node-ci-reporter.node.cjs scripts/desktop-assembly-observer.node.cjs scripts/desktop-workflow-timing.node.cjs scripts/desktop-shortcut-key-event.node.cjs scripts/desktop-camera-input.node.cjs scripts/desktop-save-observation.node.cjs",
    "package:win": "npm run build && electron-builder --win portable --publish never",
    "package:mac": "npm run build && electron-builder --mac zip --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "test:desktop:assembly-line-path": "node scripts/desktop-assembly-line-path.cjs",
    "test:desktop:assembly-circular-path": "node scripts/desktop-assembly-circular-path.cjs",
    "test:desktop:assembly-linked-source": "node scripts/desktop-assembly-linked-source.cjs",
    "test:desktop:assembly-source-revision": "node scripts/desktop-assembly-source-revision.cjs",
    "test:desktop:assembly-hinge": "node scripts/desktop-assembly-hinge.cjs",
    "test:desktop:assembly-hinge-picking": "node scripts/desktop-assembly-hinge-picking.cjs",
    "test:desktop:assembly-hinge-repair": "node scripts/desktop-assembly-hinge-repair.cjs",
    "test:desktop:assembly-hinge-limits": "node scripts/desktop-assembly-hinge-limits.cjs",
    "test:desktop:assembly-hinge-limits-repair": "node scripts/desktop-assembly-hinge-limits-repair.cjs",
    "test:desktop:assembly-hinge-limits-picking": "node scripts/desktop-assembly-hinge-limits-picking.cjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "lucide-react": "1.55.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.solidflow.desktop",
    "productName": "SolidFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.graphics"
    },
    "linux": {
      "icon": "public/solidflow.svg",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics",
      "maintainer": "SolidFlow contributors"
    }
  },
  "license": "GPL-3.0-only",
  "author": "SolidFlow contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/angelcp2802/solidflow.git"
  },
  "homepage": "https://github.com/angelcp2802/solidflow#readme",
  "bugs": {
    "url": "https://github.com/angelcp2802/solidflow/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
